CCEffect %{
  techniques:
  - passes:
    - vert: flame-vs:vert
      frag: flame-fs:frag
      rasterizerState: { cullMode: none }
      depthStencilState: { depthTest: true, depthWrite: false }
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendSrcAlpha: one
          blendDstAlpha: one_minus_src_alpha
      properties:
        mainTexture: { value: white }
        distortionTexture: { value: white }
        maskTexture: { value: white }
        dissolveTexture: { value: white }
        tint: { value: [1, 1, 1, 1] }
        floatFlow: { value: [1, 1, 0, 0] }
        distortionFlow: { value: [1, 1, 0, 0] }
        dissolveFlow: { value: [1, 1, 0, 0] }
        strengths: { value: [0, 1, 1, 1] }
        dissolveClock: { value: [0, 1, 0, 0] }
  - passes:
    - vert: flame-vs:vert
      frag: flame-fs:frag
      rasterizerState: { cullMode: none }
      depthStencilState: { depthTest: true, depthWrite: false }
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one
          blendSrcAlpha: one
          blendDstAlpha: one
      properties:
        mainTexture: { value: white }
        distortionTexture: { value: white }
        maskTexture: { value: white }
        dissolveTexture: { value: white }
        tint: { value: [1, 1, 1, 1] }
        floatFlow: { value: [1, 1, 0, 0] }
        distortionFlow: { value: [1, 1, 0, 0] }
        dissolveFlow: { value: [1, 1, 0, 0] }
        strengths: { value: [0, 1, 1, 1] }
        dissolveClock: { value: [0, 1, 0, 0] }
}%
CCProgram flame-vs %{
  precision highp float;
  #include <legacy/input>
  #include <builtin/uniforms/cc-global>
  #include <legacy/local-batch>
  out vec2 v_uv;
  vec4 vert () {
    vec4 p; CCVertInput(p);
    mat4 world; CCGetWorldMatrix(world);
    v_uv = a_texCoord;
    return cc_matProj * cc_matView * world * p;
  }
}%
CCProgram flame-fs %{
  precision highp float;
  #include <legacy/output-standard>
  in vec2 v_uv;
  uniform sampler2D mainTexture;
  uniform sampler2D distortionTexture;
  uniform sampler2D maskTexture;
  uniform sampler2D dissolveTexture;
  uniform FlameParams { vec4 tint; vec4 floatFlow; vec4 distortionFlow; vec4 dissolveFlow; vec4 strengths; vec4 dissolveClock; };
  // Match the validated Three reference: sampled PNG channels are raw encoded
  // RGB (NoColorSpace/RGBA8888); decode colour/tint once, not the data masks.
  vec3 FlameSRGBToLinear (vec3 c) {
    return mix(c / 12.92, pow((c + 0.055) / 1.055, vec3(2.4)), step(vec3(0.04045), c));
  }
  vec3 FlameLinearToSRGB (vec3 c) {
    return mix(c * 12.92, 1.055 * pow(max(c, vec3(0.0)), vec3(1.0 / 2.4)) - 0.055, step(vec3(0.0031308), c));
  }
  vec4 FlameOutput (vec4 color) {
    #if CC_USE_RGBE_OUTPUT
      color = packRGBE(color.rgb);
    #elif !CC_USE_FLOAT_OUTPUT
      #if CC_USE_HDR && CC_TONE_MAPPING_TYPE == HDR_TONE_MAPPING_ACES
        color.rgb = ACESToneMap(color.rgb);
      #endif
      color.rgb = FlameLinearToSRGB(color.rgb);
    #endif
    return color;
  }
  vec4 frag () {
    float clock = dissolveClock.z;
    float d = texture(distortionTexture, fract(v_uv * distortionFlow.xy + clock * distortionFlow.zw)).r;
    vec2 uv = v_uv * floatFlow.xy + vec2(d * strengths.x) + clock * floatFlow.zw;
    vec4 c = texture(mainTexture, fract(uv));
    float mask = pow(texture(maskTexture, fract(v_uv)).r + 0.01, strengths.w);
    float dissolve = pow(clamp((texture(dissolveTexture, fract(v_uv * dissolveFlow.xy + clock * dissolveFlow.zw)).r - dissolveClock.x + 0.1) * 5.0, 0.0, 1.0), dissolveClock.y);
    c.rgb = FlameSRGBToLinear(c.rgb) * FlameSRGBToLinear(tint.rgb) * strengths.y;
    c.a *= mask * dissolve * strengths.z;
    return FlameOutput(c);
  }
}%
