CCEffect %{
  techniques:
  - passes:
    - vert: arrow-vs:vert
      frag: arrow-fs:frag
      rasterizerState:
        cullMode: none
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one
          blendSrcAlpha: one
          blendDstAlpha: one
      properties:
        flowTexture: { value: white }
        backgroundTexture: { value: white }
}%
CCProgram arrow-vs %{
  precision highp float;
  #include <legacy/input>
  #include <builtin/uniforms/cc-global>
  #include <legacy/local-batch>
  out vec2 v_uv;
  vec4 vert () {
    vec4 position; CCVertInput(position);
    mat4 world; CCGetWorldMatrix(world);
    v_uv = a_texCoord;
    return cc_matProj * cc_matView * world * position;
  }
}%
CCProgram arrow-fs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  in vec2 v_uv;
  uniform sampler2D flowTexture;
  uniform sampler2D backgroundTexture;
  vec4 frag () {
    vec4 flow = texture(flowTexture,vec2(v_uv.x,fract(v_uv.y-cc_time.x)));
    vec4 background = texture(backgroundTexture,v_uv);
    return flow*flow.a + background*(1.0-flow.a);
  }
}%
